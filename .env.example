# Modelo de configuração para DESENVOLVIMENTO LOCAL.
# 1. Copie este arquivo para ".env" na raiz do repositório.
# 2. Troque "troque-esta-senha-local" por uma senha sua (a mesma nas duas linhas abaixo).
# O ".env" nunca vai para o Git (.gitignore). Em produção o .env é ignorado: use variáveis
# de ambiente da plataforma. Nenhum valor real deve ser colocado neste arquivo de modelo.

# --- Banco local (usado pelo Docker Compose: compose.yaml) ---
POSTGRES_DB=fila
POSTGRES_USER=fila
POSTGRES_PASSWORD=troque-esta-senha-local

# --- Aplicação (backend Go) ---
# Ambiente: development, test, homologacao ou production (homologação e produção ignoram este arquivo).
FILA_ENV=development
# Formato: postgres://usuario:senha@host:porta/banco?sslmode=...
FILA_DATABASE_URL=postgres://fila:troque-esta-senha-local@127.0.0.1:5432/fila?sslmode=disable
# Endereço da API. 127.0.0.1 = só este computador.
FILA_HTTP_ADDR=127.0.0.1:8080
# Logs: nível (debug, info, warn, error) e formato (json ou text).
FILA_LOG_LEVEL=info
FILA_LOG_FORMAT=text

# Chave secreta do servidor (protege sessões, códigos de visitante e e-mails na fila de envio).
# Gere a SUA com o comando abaixo e cole o resultado depois do "=" (nunca compartilhe):
#   go -C backend run ./cmd/fila-admin gerar-chave
FILA_SECRET_KEY=
# Troca da chave (ver docs/operacao/rotinas.md): a chave ANTIGA vai aqui por 30 dias, só para
# reconhecer códigos e protocolos já emitidos. Separe por vírgula (máximo 3).
# FILA_SECRET_KEY_PREVIOUS=
#
# Segredos também podem vir de ARQUIVO (homologação/produção: segredos da plataforma montados
# como arquivo). Use NOME_FILE=/caminho no lugar de NOME, nunca os dois. Vale para:
# FILA_DATABASE_URL, FILA_SECRET_KEY, FILA_SECRET_KEY_PREVIOUS, FILA_ABACATEPAY_API_KEY,
# FILA_ABACATEPAY_WEBHOOK_SECRET. Ex.: FILA_SECRET_KEY_FILE=/run/secrets/fila_secret_key

# Cookies: false só em desenvolvimento com http://. Em produção é sempre true (HTTPS).
FILA_COOKIE_SECURE=false
# E-mails: "file" grava cada e-mail como arquivo de texto na pasta abaixo (só desenvolvimento).
# Em produção use "disabled" até haver um provedor de e-mail configurado.
FILA_MAIL_MODE=file
# Pasta relativa a backend/ (os comandos rodam com "go -C backend").
FILA_MAIL_DIR=.correio

# --- Opcionais (valor padrão mostrado; descomente para mudar) ---
# FILA_HTTP_READ_HEADER_TIMEOUT=5s
# FILA_HTTP_READ_TIMEOUT=15s
# FILA_HTTP_WRITE_TIMEOUT=30s
# FILA_HTTP_IDLE_TIMEOUT=60s
# FILA_SHUTDOWN_TIMEOUT=20s
# FILA_DB_MAX_CONNS=10
# FILA_DB_CONNECT_TIMEOUT=5s
# Origens (endereço do site) aceitas em pedidos que alteram dados; separe por vírgula.
# FILA_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Endereço do site usado nos links enviados por e-mail.
# FILA_PUBLIC_BASE_URL=http://127.0.0.1:5173
# Só ative atrás de um proxy reverso SEU que sobrescreve X-Forwarded-For.
# FILA_TRUST_X_FORWARDED_FOR=false

# --- Operação (etapa 12; ver docs/operacao/) ---
# Métricas (formato Prometheus) num endereço SEPARADO, nunca publicado na internet. Vazio = desligado.
# FILA_METRICS_ADDR=127.0.0.1:9090
# Limite geral por IP (por processo da API) e conexões de tempo real (SSE).
# FILA_HTTP_REQUESTS_PER_MINUTE=600
# FILA_SSE_MAX_CONNECTIONS=2000
# FILA_SSE_MAX_PER_IP=100
# Diário de exclusões fora do banco (reaplicar exclusões depois de restaurar backup). Vazio = desligado.
# FILA_DELETION_JOURNAL_DIR=

# --- Pix (AbacatePay). Desligado por padrão: só dinheiro e cartão presencial. ---
# Para testar, use a chave de TESTE (abc_dev_...) do painel da AbacatePay. Ver docs/pagamentos-abacatepay.md.
# FILA_PIX_PROVIDER=disabled
# FILA_ABACATEPAY_API_KEY=
# FILA_ABACATEPAY_BASE_URL=https://api.abacatepay.com/v2
# FILA_PIX_EXPIRES_IN=15m
# FILA_ABACATEPAY_TIMEOUT=10s
# Secret do webhook (o mesmo cadastrado na AbacatePay, 32+ caracteres). Vazio = webhook desligado.
# FILA_ABACATEPAY_WEBHOOK_SECRET=
# Em produção só o endereço oficial (https://api.abacatepay.com/v2) é aceito.
# Só em produção, depois do checklist de validação:
# FILA_ABACATEPAY_PRODUCTION_VALIDATED=false
