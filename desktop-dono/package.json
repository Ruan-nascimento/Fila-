{
  "name": "fila-gestao-desktop",
  "private": true,
  "version": "1.1.0",
  "description": "Fila Gestão: programa instalável do dono (Tauri 2): gestão do site + Dashboard analítico local",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "tauri": "tauri",
    "dev": "npm run build:ui && tauri dev",
    "icone": "tauri icon icone/icone.svg",
    "build:windows": "tauri build --bundles nsis",
    "build:linux": "tauri build --bundles deb",
    "build:linux:appimage": "tauri build --bundles appimage",
    "build:ui": "tsc -p dashboard/tsconfig.json && vite build --config dashboard/vite.config.ts && node scripts/copiar-carregador.mjs",
    "test:ui": "vitest run --config dashboard/vite.config.ts"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.4",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "lucide-react": "1.66.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.5"
  }
}
