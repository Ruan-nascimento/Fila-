# Imagem com o site compilado (frontend). Ela NÃO fica no ar: na implantação, o serviço "site"
# do compose usa esta imagem só para PUBLICAR os arquivos no volume que o Caddy (sempre no ar)
# serve. Assim trocar de versão não derruba a porta pública (docs/operacao/implantacao.md).
# Construir (na raiz):  docker build -f deploy/Dockerfile.web -t fila-web .
# Nenhuma variável VITE_ com segredo: o site é verificado no CI (grep de segredos).

FROM node:26.13.1-alpine@sha256:6bd9ab43c0ec0190ca7b2d193906cb8b7edf6e7f4afa43ddeccd6452710bffb5 AS build
WORKDIR /app/frontend
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 CI=1
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
RUN npm run build

FROM caddy:2.11.9-alpine@sha256:003a97808e781aa9f7e75cc2f43d34d461099031faf5e20faefb9f61126836f0
COPY --from=build /app/frontend/dist /srv
COPY deploy/caddy/publicar-site.sh /usr/local/bin/publicar-site.sh
ENTRYPOINT ["sh", "/usr/local/bin/publicar-site.sh"]
