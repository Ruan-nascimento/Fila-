# Configuração da APLICAÇÃO em produção (api, worker, migrate, fila-admin) — modelo, sem segredo.
# Os segredos (FILA_DATABASE_URL, FILA_SECRET_KEY, chaves da AbacatePay) vêm por *_FILE no compose.
FILA_ENV=production
FILA_LOG_LEVEL=info
FILA_LOG_FORMAT=json
FILA_ALLOWED_ORIGINS=https://fila.exemplo.com.br
FILA_PUBLIC_BASE_URL=https://fila.exemplo.com.br
FILA_COOKIE_SECURE=true
FILA_DB_MAX_CONNS=20
# Sem provedor de e-mail contratado ainda: verificação, redefinição e convites NÃO chegam (bloqueio externo).
FILA_MAIL_MODE=disabled
# Pix desligado até o checklist (docs/pagamentos-abacatepay.md). Para ligar:
# FILA_PIX_PROVIDER=abacatepay
# FILA_ABACATEPAY_PRODUCTION_VALIDATED=true
FILA_PIX_PROVIDER=disabled
FILA_HTTP_REQUESTS_PER_MINUTE=600
FILA_SSE_MAX_CONNECTIONS=2000
FILA_SSE_MAX_PER_IP=100
