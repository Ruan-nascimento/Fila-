# Ambiente de HOMOLOGAÇÃO — modelo (usado no exercício local da etapa 12; ver docs/operacao/).
# Mesmas travas de produção; Pix só com chave de TESTE (simulador local ou sandbox da AbacatePay).
FILA_AMBIENTE=homologacao
# Local: https://localhost:8443 com certificado da CA interna do Caddy.
FILA_DOMINIO=localhost
FILA_TLS_MODO=interno
FILA_PORTA_HTTP=8080
FILA_PORTA_HTTPS=8443
FILA_SEGREDOS=/caminho/para/segredos-homologacao
FILA_CONFIG=/caminho/para/aplicacao-homologacao.env
FILA_DIARIO_DIR=/caminho/para/diario
FILA_BACKUPS_DIR=/caminho/para/backups
FILA_BACKUP_RETENCAO_DIAS=3
FILA_BANCO_LOCAL=1
FILA_PIX_CHAVE_ARQUIVO=/run/secrets/abacatepay_api_key
FILA_CURL_INSEGURO=1
