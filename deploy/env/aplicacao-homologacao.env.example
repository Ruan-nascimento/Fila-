# Configuração da APLICAÇÃO em homologação — modelo, sem segredo.
FILA_ENV=homologacao
FILA_LOG_LEVEL=info
FILA_LOG_FORMAT=json
FILA_ALLOWED_ORIGINS=https://localhost:8443
FILA_PUBLIC_BASE_URL=https://localhost:8443
FILA_COOKIE_SECURE=true
# Sem provedor de e-mail: os e-mails viram arquivos no volume "correio" (só homologação).
FILA_MAIL_MODE=file
FILA_PIX_PROVIDER=abacatepay
# Simulador local (rede do compose) ou sandbox da AbacatePay com chave abc_dev_.
FILA_ABACATEPAY_BASE_URL=http://pixfake:18090/v2
