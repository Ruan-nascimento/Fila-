# Ambiente de PRODUÇÃO — modelo. Copie para FORA do repositório (ex.: /etc/fila/producao.env).
# Este arquivo NÃO tem segredo: os segredos são arquivos em FILA_SEGREDOS (ver compose.yaml e
# docs/operacao/implantacao.md). Duas partes:
#   1. variáveis do compose (onde estão as coisas, domínio, portas);
#   2. FILA_CONFIG: o arquivo com a configuração da aplicação (abaixo, aplicacao-producao.env).

FILA_AMBIENTE=producao
FILA_DOMINIO=fila.exemplo.com.br
FILA_TLS_MODO=acme
FILA_SEGREDOS=/etc/fila/segredos
FILA_CONFIG=/etc/fila/aplicacao-producao.env
# Em OUTRO disco que o do banco (e copiado para fora do servidor junto com os backups).
FILA_DIARIO_DIR=/srv/fila-diario
FILA_BACKUPS_DIR=/srv/fila-backups
FILA_BACKUP_RETENCAO_DIAS=14
# 1 = PostgreSQL neste servidor (perfil banco-local); 0 = banco gerenciado (ajuste FILA_BANCO_HOST).
FILA_BANCO_LOCAL=1
# FILA_BANCO_HOST=meu-banco-gerenciado.exemplo.com
# Pix real: só depois do checklist de docs/pagamentos-abacatepay.md. Caminhos DENTRO do contêiner.
# FILA_PIX_CHAVE_ARQUIVO=/run/secrets/abacatepay_api_key
# FILA_PIX_WEBHOOK_ARQUIVO=/run/secrets/abacatepay_webhook_secret
